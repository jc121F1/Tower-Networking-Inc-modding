{
	"id": "ups-powered-rack",
	"name": "Everything's UPS Powered Racks",
	"authors": [ "Everything" ],
	"version": "0.1.0",
	"description": [
		"Allows UPS mounted in a rack to power any other device in the rack.",
		"Transfers power only while the UPS and target are locked into the same rack Mount.",
		"Restores original power controllers when the rack relationship ends."
	],
	"links": {},
	"dependencies": {
		"tower-networking-inc": "^0.12.0",
		"luajit-support": "~0.2.0"
	},
	"dependencies_optional": {},
	"incompatibilities": {}
}
